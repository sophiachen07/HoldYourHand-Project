# 複製成 .env 後填入自己的值（.env 不會上傳到 GitHub）

# Google Gemini API（樹洞 AI 聊天，推薦！免費免信用卡且繁中流暢）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face（樹洞 AI 聊天備用）
HF_API_KEY=

# MySQL 資料庫
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=holdyourhand
# 雲端資料庫 SSL 設定（如 Aiven MySQL，若連線 localhost 本機則留空不需設定）
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=

# Google 登入（Google Cloud Console 的「網頁應用程式」用戶端 ID）
GOOGLE_CLIENT_ID=

# JWT 安全憑證設定（正式環境請設定強隨機字串，例如 openssl rand -hex 32）
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 電子郵件 OTP 驗證信設定 (SMTP)
# 未設定時伺服器將以開發模式運行，驗證碼將安全輸出於終端機日誌供測試
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HoldYourHand" <no-reply@holdyourhand.app>
